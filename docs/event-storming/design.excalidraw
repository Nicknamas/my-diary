      "created": 1792550123337,
      "link": null,
      "locked": false,
      "text": "Как платформа\nузнаёт об\nуспехе или\nошибке запуска\nпроекта",
      "fontSize": 20,
      "baseFontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s2PmdgsWMKdExd-kRYYiM",
      "originalText": "Как платформа узнаёт об успехе или ошибке запуска проекта",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
